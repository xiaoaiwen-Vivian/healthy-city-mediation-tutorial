. capture program drop fit_paths

. program define fit_paths
  1.     syntax, MED(varname) CONTROLS(string) CANDIDATE(string) OMITTED(string) ///
>         HANDLE(name) EXPECTEDN(integer) EXPECTEDG(integer) EXPECTEDT(integer) ///
>         REMOVED(integer) PERSONSREMOVED(integer)
  2.     tempvar sa sb tag tagperson
  3.     tempname a b ase bse adf bdf ap bp alo ahi blo bhi
  4.     quietly reghdfe `med' did `controls', absorb(city_id year) vce(cluster city_id)
  5.     generate byte `sa'=e(sample)
  6.     scalar `a'=_b[did]
  7.     scalar `ase'=_se[did]
  8.     scalar `adf'=e(df_r)
  9.     assert `ase'>0 & `ase'<.
 10.     assert e(N)==`expectedn'
 11.     assert `sa'==1
 12.     scalar `ap'=2*ttail(`adf',abs(`a'/`ase'))
 13.     scalar `alo'=`a'-invttail(`adf',.025)*`ase'
 14.     scalar `ahi'=`a'+invttail(`adf',.025)*`ase'
 15.     quietly reghdfe outcome `med' did `controls', absorb(city_id year) vce(cluster city_id)
 16.     generate byte `sb'=e(sample)
 17.     scalar `b'=_b[`med']
 18.     scalar `bse'=_se[`med']
 19.     scalar `bdf'=e(df_r)
 20.     assert `bse'>0 & `bse'<.
 21.     assert e(N)==`expectedn'
 22.     assert `sa'==`sb'
 23.     scalar `bp'=2*ttail(`bdf',abs(`b'/`bse'))
 24.     scalar `blo'=`b'-invttail(`bdf',.025)*`bse'
 25.     scalar `bhi'=`b'+invttail(`bdf',.025)*`bse'
 26.     egen byte `tag'=tag(city_id) if `sa'
 27.     quietly count if `tag'==1
 28.     local cities=r(N)
 29.     quietly count if `tag'==1 & treated==1
 30.     local treatedcities=r(N)
 31.     egen byte `tagperson'=tag(respondent_id) if `sa'
 32.     quietly count if `tagperson'==1
 33.     local persons=r(N)
 34.     assert `cities'==`expectedg'
 35.     assert `treatedcities'==`expectedt'
 36.     assert `adf'==`expectedg'-1
 37.     assert `bdf'==`expectedg'-1
 38.     post `handle' ("`candidate'") ("`omitted'") (`expectedn') (`persons') (`cities') (`treatedcities') ///
>         (`removed') (`personsremoved') (`a') (`b') (`a'*`b') (`ase') (`bse') (`ap') (`bp') ///
>         (`adf') (`bdf') (`alo') (`ahi') (`blo') (`bhi') (1)
 39.     display "FIT `candidate' | omitted `omitted' | N=" `expectedn' " | cities=" `cities' " | treated=" `treatedcities' ///
>         " | a=" %18.12g `a' " | b=" %18.12g `b' " | ab=" %18.12g (`a'*`b')
 40. end

. 
. local labels Green Road SO2 Medical PM25 Social

. local mediators m_green m_road m_so2 m_medical m_pm25 m_social

. local expected_n 16661 16661 15430 11141 16661 16660

. forvalues j=1/6 {
  2.     use `eligible', clear
  3.     local med: word `j' of `mediators'
  4.     local label: word `j' of `labels'
  5.     local n_expected: word `j' of `expected_n'
  6.     quietly reghdfe outcome `med' did `controls' if baseline, absorb(city_id year) vce(cluster respondent_id)
  7.     generate byte common=e(sample)
  8.     keep if common
  9.     assert _N==`n_expected'
 10.     save `common', replace
 11.     fit_paths, med(`med') controls("`controls'") candidate(`label') omitted(Full) handle(`result') ///
>         expectedn(`n_expected') expectedg(94) expectedt(10) removed(0) personsremoved(0)
 12.     forvalues k=1/10 {
 13.         use `common', clear
 14.         local omitted_city: word `k' of `treated_cities'
 15.         local alias= "T" + string(`k',"%02.0f")
 16.         quietly count if city_id==`omitted_city'
 17.         local removed=r(N)
 18.         assert `removed'>0
 19.         tempvar person_tag
 20.         egen byte `person_tag'=tag(respondent_id) if city_id==`omitted_city'
 21.         quietly count if `person_tag'==1
 22.         local persons_removed=r(N)
 23.         drop if city_id==`omitted_city'
 24.         local n_retained=_N
 25.         assert `n_retained'==`n_expected'-`removed'
 26.         fit_paths, med(`med') controls("`controls'") candidate(`label') omitted(`alias') handle(`result') ///
>             expectedn(`n_retained') expectedg(93) expectedt(9) removed(`removed') personsremoved(`persons_removed')
 27.     }
 28. }
