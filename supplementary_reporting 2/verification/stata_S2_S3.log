. use "`input_path'", clear
(Harmonized CHARLS Ver.D)

. rename (ID iwy treat rgoingl) (person_id year treated outcome)

. rename (GreenCoverageRateBD RoadSurAreaPerCap 工业二氧化硫排放量吨 hosper pm act_12) (m_green m_road m_so2 m_medical m_pm25 m_social)

. replace city=strtrim(city)
(0 real changes made)

. drop if missing(person_id) | missing(wave) | missing(city) | missing(year)
(1,310 observations deleted)

. keep if age>=45 & age<. & rural==0
(51,158 observations deleted)

. replace did=treated*(year>=2017)
(0 real changes made)

. local controls gender marry log_real_inc_per rwork rural2 edu hchild retire adlab_c smoken drinkl srh age

. local meds m_green m_road m_so2 m_medical m_pm25 m_social

. local labels Green Road SO2 Medical PM25 Social

. egen long city_id=group(city)

. quietly reghdfe outcome did `controls', absorb(city_id year) vce(cluster city_id)

. generate byte base=e(sample)

. assert e(N)==16661

. tempname d c

. postfile `d' str32 Variable str20 Group double N double Mean double SD double Count_1 double Percent_1 double Eligible double Missing double Percent_missing using "stata_descriptives.dta", replace
(file stata_descriptives.dta not found)

. foreach v in outcome did `controls' `meds' {
  2.     forvalues g=0/2 {
  3.         if `g'==0 {
  4.             local group "All"
  5.             local cond "1"
  6.         }
  7.         if `g'==1 {
  8.             local group "Untreated cities"
  9.             local cond "treated==0"
 10.         }
 11.         if `g'==2 {
 12.             local group "Treated cities"
 13.             local cond "treated==1"
 14.         }
 15.         quietly summarize `v' if base & (`cond')
 16.         local n=r(N)
 17.         local mean=r(mean)
 18.         local sd=r(sd)
 19.         quietly count if base & (`cond') & `v'==1
 20.         local one=r(N)
 21.         quietly count if (`cond')
 22.         local eligible=r(N)
 23.         quietly count if (`cond') & missing(`v')
 24.         local missing=r(N)
 25.         post `d' ("`v'") ("`group'") (`n') (`mean') (`sd') (`one') (100*`one'/`n') (`eligible') (`missing') (100*`missing'/`eligible')
 26.     }
 27. }

. postclose `d'

. 
. postfile `c' str20 Candidate str1 Path str8 Model double N double Estimate double SE double CI_lower double CI_upper double Clusters double TreatedCities using "stata_coefficients.dta", replace
(file stata_coefficients.dta not found)

. foreach model in Crude Adjusted {
  2.     if "`model'"=="Crude" quietly regress outcome did if base, vce(cluster city_id)
  3.     else quietly reghdfe outcome did `controls' if base, absorb(city_id year) vce(cluster city_id)
  4.     scalar crit=invttail(e(df_r),.025)
  5.     post `c' ("Overall policy") ("c") ("`model'") (e(N)) (_b[did]) (_se[did]) (_b[did]-crit*_se[did]) (_b[did]+crit*_se[did]) (e(N_clust)) (10)
  6. }

. local i=0

. foreach m of local meds {
  2.     local ++i
  3.     local label: word `i' of `labels'
  4.     quietly reghdfe outcome `m' did `controls' if base, absorb(city_id year) vce(cluster city_id)
  5.     generate byte common_`i'=e(sample)
  6.     quietly egen byte tag_`i'=tag(city_id) if common_`i'
  7.     quietly count if tag_`i'==1 & treated==1
  8.     local treated_count=r(N)
  9.     foreach model in Crude Adjusted {
 10.         if "`model'"=="Crude" quietly regress `m' did if common_`i', vce(cluster city_id)
 11.         else quietly reghdfe `m' did `controls' if common_`i', absorb(city_id year) vce(cluster city_id)
 12.         assert e(sample)==common_`i'
 13.         scalar crit=invttail(e(df_r),.025)
 14.         post `c' ("`label'") ("a") ("`model'") (e(N)) (_b[did]) (_se[did]) (_b[did]-crit*_se[did]) (_b[did]+crit*_se[did]) (e(N_clust)) (`treated_count')
 15.         if "`model'"=="Crude" quietly regress outcome `m' did if common_`i', vce(cluster city_id)
 16.         else quietly reghdfe outcome `m' did `controls' if common_`i', absorb(city_id year) vce(cluster city_id)
 17.         assert e(sample)==common_`i'
 18.         scalar crit=invttail(e(df_r),.025)
 19.         post `c' ("`label'") ("b") ("`model'") (e(N)) (_b[`m']) (_se[`m']) (_b[`m']-crit*_se[`m']) (_b[`m']+crit*_se[`m']) (e(N_clust)) (`treated_count')
 20.     }
 21. }

. postclose `c'

. use "stata_descriptives.dta", clear

