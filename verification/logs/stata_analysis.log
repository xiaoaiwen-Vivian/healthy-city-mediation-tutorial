. do code/fdr_stata.do

. version 18.0

. clear all

. set more off

. set type double

. 
. * BEGIN bh
. capture program drop bh_adjust

. program define bh_adjust
  1.     syntax varname(numeric), Generate(name)
  2.     tempvar original_order rank scaled
  3.     generate long `original_order'=_n
  4.     sort `varlist' `original_order'
  5.     generate long `rank'=_n
  6.     generate double `scaled'=`varlist'*_N/`rank'
  7.     generate double `generate'=min(1,`scaled')
  8.     local last=_N-1
  9.     forvalues j=`last'(-1)1 {
 10.         quietly replace `generate'= ///
>             min(`generate',`generate'[_n+1]) in `j'
 11.     }
 12.     sort `original_order'
 13. end

. * END bh
. 
. * BEGIN product_bh
