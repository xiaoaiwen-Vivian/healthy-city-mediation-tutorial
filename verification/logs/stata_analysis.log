. forvalues j=1/6 {
  2.     use `eligible', clear
  3.     local med : word `j' of `mediators'
  4.     local label : word `j' of `labels'
  5.     * BEGIN common_sample
.     quietly reghdfe outcome `med' did `controls' if baseline, ///
>         absorb(city_id year) vce(cluster respondent_id)
  6.     generate byte common=e(sample)
  7.     keep if common
  8.     * END common_sample
.     foreach level in Individual City {
  9.         local cluster respondent_id
 10.         if "`level'"=="City" local cluster city_id
 11.         * BEGIN stored_paths
.         quietly reghdfe outcome `med' did `controls', ///
>             absorb(city_id year) vce(cluster `cluster')
 12.         assert e(sample)==1
 13.         scalar b=_b[`med']
 14.         scalar se_b=_se[`med']
 15.         post `common' ("`label'") ("`level'") ("b") (e(N)) ///
>             (scalar(b)) (scalar(se_b)) (2*ttail(e(df_r),abs(scalar(b)/scalar(
> se_b))))
 16.         quietly reghdfe `med' did `controls', ///
>             absorb(city_id year) vce(cluster `cluster')
 17.         assert e(sample)==1
 18.         scalar a=_b[did]
 19.         scalar se_a=_se[did]
 20.         scalar indirect=scalar(a)*scalar(b)
 21.         * END stored_paths
.         post `common' ("`label'") ("`level'") ("a") (e(N)) ///
>             (scalar(a)) (scalar(se_a)) (2*ttail(e(df_r),abs(scalar(a)/scalar(
> se_a))))
 22.     }
 23.     * BEGIN sobel
.     scalar sobel_se=sqrt(scalar(b)^2*scalar(se_a)^2 ///
>         + scalar(a)^2*scalar(se_b)^2)
 24.     scalar sobel_z=scalar(indirect)/scalar(sobel_se)
 25.     scalar sobel_p=2*normal(-abs(scalar(sobel_z)))
 26.     scalar sobel_lower=scalar(indirect)-invnormal(.975)*scalar(sobel_se)
 27.     scalar sobel_upper=scalar(indirect)+invnormal(.975)*scalar(sobel_se)
 28.     * END sobel
.     local N=_N
 29.     local G=e(N_clust)
 30.     egen byte city_tag=tag(city_id)
 31.     quietly count if city_tag & treated==1
 32.     local treatedN=r(N)
 33.     quietly tabulate year, generate(wave_indicator)
 34.     drop wave_indicator1
 35.     ds wave_indicator*
 36.     local years `r(varlist)'
 37.     sort city_id person_id year
 38.     mata: city_products("`med'","did `controls' `years'", ///
>         "results/stata/city_draws_`label'.csv",city_counts)
 39.     import delimited using "results/stata/city_draws_`label'.csv", clear
 40.     * BEGIN intervals
.     quietly count
 41.     scalar B=r(N)
 42.     quietly count if ab<=scalar(indirect)
 43.     scalar fraction=r(N)/B
 44.     scalar z0=invnormal(max(.0001,min(.9999,fraction)))
 45.     scalar prob_lower=normal(2*z0+invnormal(.025))
 46.     scalar prob_upper=normal(2*z0+invnormal(.975))
 47.     mata: v=st_data(.,"ab")
 48.     mata: st_numscalar("pct_lower",hc_q(v,.025))
 49.     mata: st_numscalar("pct_upper",hc_q(v,.975))
 50.     mata: st_numscalar("bc_lower",hc_q(v,st_numscalar("prob_lower")))
 51.     mata: st_numscalar("bc_upper",hc_q(v,st_numscalar("prob_upper")))
 52.     * END intervals
.     quietly count if ab<0
 53.     scalar negative=r(N)
 54.     quietly count if ab>0
 55.     scalar positive=r(N)
 56.     quietly count if ab==0
 57.     scalar zero=r(N)
 58.     scalar tail=min(1,2*(min(negative,positive)+1)/(B+1))
 59.     post `result' ("`label'") (`N') (`G') (`treatedN') ///
>         (scalar(a)) (scalar(b)) (scalar(indirect)) (scalar(se_a)) (scalar(se_
> b)) ///
>         (scalar(sobel_se)) (scalar(sobel_p)) (scalar(sobel_lower)) (scalar(so
> bel_upper)) ///
>         (scalar(B)) (scalar(pct_lower)) (scalar(pct_upper)) (scalar(bc_lower)
> ) (scalar(bc_upper)) ///
>         (scalar(z0)) (scalar(prob_lower)) (scalar(prob_upper)) (scalar(negati
> ve)) (scalar(positive)) (scalar(zero)) (scalar(tail))
 60.     display "`label': 2000 city products and both intervals complete"
 61. }
