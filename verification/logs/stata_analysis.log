. 
. foreach fixed in City Individual {
  2.     use `eligible', clear
  3.     local absorbed city_id
  4.     if "`fixed'"=="Individual" local absorbed respondent_id
  5.     local sample_set 0
  6.     foreach level in Individual City {
  7.         local cluster respondent_id
  8.         if "`level'"=="City" local cluster city_id
  9.         display "FIXED EFFECTS: `fixed' and year; CLUSTERING: `level'"
 10.         reghdfe outcome did `controls' if baseline, ///
>             absorb(`absorbed' year) vce(cluster `cluster')
 11.         if !`sample_set' {
 12.             generate byte fixed_sample=e(sample)
 13.             local sample_set 1
 14.         }
 15.         assert e(sample)==fixed_sample
 16.         scalar coef=_b[did]
 17.         scalar se=_se[did]
 18.         scalar pvalue=2*ttail(e(df_r),abs(scalar(coef)/scalar(se)))
 19.         scalar lower=scalar(coef)-invttail(e(df_r),.025)*scalar(se)
 20.         scalar upper=scalar(coef)+invttail(e(df_r),.025)*scalar(se)
 21.         local N=e(N)
 22.         local df=e(df_r)
 23.         tempvar person_tag city_tag
 24.         egen byte `person_tag'=tag(respondent_id) if e(sample)
 25.         quietly count if `person_tag'==1
 26.         local persons=r(N)
 27.         egen byte `city_tag'=tag(city_id) if e(sample)
 28.         quietly count if `city_tag'==1
 29.         local cities=r(N)
 30.         local excluded=`baselineN'-`N'
 31.         post `results' ("`fixed' + year") ("`level'") ///
>             (`N') (`persons') (`cities') (`excluded') ///
>             (scalar(coef)) (scalar(se)) (scalar(pvalue)) ///
>             (scalar(lower)) (scalar(upper)) (`df')
 32.     }
