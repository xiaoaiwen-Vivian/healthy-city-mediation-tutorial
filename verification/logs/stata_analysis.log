. capture program drop fit_wild

. program define fit_wild
  1.     syntax, DEP(varname) RHS(string) TARGET(name) CANDIDATE(string) PATH(string) ///
>         HANDLE(name) REPS(integer)
  2.     tempvar sample tag tagperson
  3.     tempname estimate se df n p lo hi ci wp feasible imposed diff sediff dist
  4.     reghdfe `dep' `rhs', absorb(city_id year) vce(cluster city_id)
  5.     generate byte `sample'=e(sample)
  6.     scalar `estimate'=_b[`target']
  7.     scalar `se'=_se[`target']
  8.     scalar `df'=e(df_r)
  9.     scalar `n'=e(N)
 10.     scalar `p'=2*ttail(`df',abs(`estimate'/`se'))
 11.     scalar `lo'=`estimate'-invttail(`df',.025)*`se'
 12.     scalar `hi'=`estimate'+invttail(`df',.025)*`se'
 13.     egen byte `tag'=tag(city_id) if `sample'
 14.     quietly count if `tag'==1
 15.     local cities=r(N)
 16.     quietly count if `tag'==1 & treated==1
 17.     local treatedcities=r(N)
 18.     egen byte `tagperson'=tag(respondent_id) if `sample'
 19.     quietly count if `tagperson'==1
 20.     local persons=r(N)
 21.     assert `cities'==94
 22.     assert `treatedcities'==10
 23. 
.     * The same city + year FE model, with year indicators written explicitly:
.     * boottest supports one absorbed FE set. Compare sample, coefficient and SE.
.     reghdfe `dep' `rhs' i.year if `sample', absorb(city_id) vce(cluster city_id)
 24.     assert e(sample)==`sample'
 25.     assert e(N)==`n'
 26.     assert e(df_r)==`df'
 27.     assert reldif(_b[`target'],`estimate')<1e-8
 28.     assert reldif(_se[`target'],`se')<1e-8
 29.     scalar `diff'=_b[`target']-`estimate'
 30.     scalar `sediff'=_se[`target']-`se'
 31.     display "CHECK: `candidate', path `path', same sample, city + year FE and coefficients verified."
 32.     boottest `target', cluster(city_id) bootcluster(city_id) reps(`reps') ///
>         seed(2025) weight(rademacher) boottype(wild) statistic(t) ///
>         ptype(symmetric) level(95) nograph format(%14.9g) ptolerance(.0001) svmat
 33.     return list
 34.     scalar `wp'=r(p)
 35.     matrix `dist'=r(dist)
 36.     mata: st_numscalar("`feasible'",sum(st_matrix("`dist'"):<.))
 37.     scalar `imposed'=r(null)
 38.     matrix `ci'=r(CI)
 39.     local cis `"`r(CIstr)'"'
 40.     local pieces=rowsof(`ci')
 41.     assert r(reps)==`reps'
 42.     assert `feasible'==`reps'
 43.     assert `imposed'==1
 44.     matrix list `ci', format(%20.12g)
 45.     post `handle' ("`candidate'") ("`path'") (`n') (`persons') (`cities') (`treatedcities') ///
>         (`estimate') (`se') (`df') (`p') (`lo') (`hi') ///
>         (`wp') (`ci'[1,1]) (`ci'[1,2]) (`reps') (`feasible') (`imposed') ///
>         (`diff') (`sediff') (`pieces') (`"`cis'"')
 46.     display "COMPLETED: `candidate', path `path'; WCB p = " %12.8f `wp'
 47. end

. 
. keep if baseline
